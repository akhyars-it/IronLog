# Copy this file to keystore.properties (gitignored) and fill in the values
# produced when you create android/keystore/ironlog-release.jks.
# Environment variables override this file when they are set:
# IRONLOG_KEYSTORE_PATH, IRONLOG_KEYSTORE_PASSWORD, IRONLOG_KEY_ALIAS, IRONLOG_KEY_PASSWORD
storeFile=keystore/ironlog-release.jks
storePassword=replace-with-store-password
keyAlias=ironlog
keyPassword=replace-with-key-password
